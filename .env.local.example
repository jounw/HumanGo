# Supabase 프로젝트 설정 > API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# (선택) 설정하면 가입 시 이 코드를 입력해야 함. 서버에서만 사용됨.
SIGNUP_CODE=

# 전설/신화 캐릭터를 AI 로 다시 그릴 때 쓰는 OpenAI API 키. 서버에서만 사용됨.
OPENAI_API_KEY=
# (선택) 기본값 gpt-image-1
OPENAI_IMAGE_MODEL=

# 등급 뽑기(/api/roll) 기록용. Supabase 설정 > API 의 service_role 키 (절대 공개 금지, 서버에서만 사용됨)
SUPABASE_SERVICE_ROLE_KEY=
